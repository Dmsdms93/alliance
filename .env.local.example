# Variables d'environnement — Alliance
# Copiez ce fichier en .env.local et remplissez avec vos valeurs Supabase

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-ici

# --- Cloudflare R2 (Stockage photos) ---
R2_ACCOUNT_ID=votre-account-id
R2_ACCESS_KEY_ID=votre-access-key
R2_SECRET_ACCESS_KEY=votre-secret-key
R2_BUCKET_NAME=alliance-photos
R2_PUBLIC_URL=https://votre-bucket.r2.dev

# --- WebSocket Chat Server (Oracle Cloud) ---
NEXT_PUBLIC_WS_URL=wss://votre-serveur-chat.example.com

# --- Webhook post-inscription (optionnel) ---
# URL appelée automatiquement après la création d'un profil
# Utilisable pour : email de bienvenue, analytics, Slack, etc.
POST_REGISTRATION_WEBHOOK_URL=
